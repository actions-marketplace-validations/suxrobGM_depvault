{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Biome parses SVG as markup and would reformat it.
      "!**/*.svg",
      // Generated by `bun run export:openapi`; Kiota reads it as-is.
      "!apps/cli/openapi.json",
      // Vendored from the upstream skill repo (skills-lock.json), not ours to reformat.
      "!.agents/skills",
      "!.claude/skills/remotion-best-practices"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        // `noUncheckedIndexedAccess` needs `!` on guarded lookups; the `?.` autofix changes behavior.
        "noNonNullAssertion": "off",
        "noNestedTernary": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ":BUN:", ":PACKAGE:", "@/**", ":PATH:"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // React leads the package group in JSX files.
      "includes": ["**/*.jsx", "**/*.tsx"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": {
              "level": "on",
              "options": {
                "groups": [
                  ":NODE:",
                  ":BUN:",
                  ["react", "react/**", "react-dom", "react-dom/**"],
                  ":PACKAGE:",
                  "@/**",
                  ":PATH:"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/frontend/**", "apps/docs/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        },
        "rules": {
          "correctness": {
            // It demands useCallback/useMemo, which the React Compiler makes unnecessary.
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      // Remotion renders these components to video frames: no assistive tech, no reordering.
      "includes": ["apps/demo-video/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        },
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
