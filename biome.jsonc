{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Biome parses SVG as markup and would reformat it.
      "!**/*.svg",
      // Generated by `bun run export:openapi`; Kiota reads it as-is.
      "!apps/cli/openapi.json",
      // Vendored from the upstream skill repo (skills-lock.json), not ours to reformat.
      "!.agents/skills",
      "!.claude/skills/remotion-best-practices"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "parser": {
      // tsyringe injects via constructor parameter decorators (`@inject(TOKEN)`).
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        // `noUncheckedIndexedAccess` forces `!` on Record and array lookups the code has
        // already guarded; Biome's `?.` autofix would silently change behavior.
        "noNonNullAssertion": "off",
        "noNestedTernary": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ":BUN:", ":PACKAGE:", "@/**", ":PATH:"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // React leads the package group in JSX files.
      "includes": ["**/*.jsx", "**/*.tsx"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": {
              "level": "on",
              "options": {
                "groups": [
                  ":NODE:",
                  ":BUN:",
                  ["react", "react/**", "react-dom", "react-dom/**"],
                  ":PACKAGE:",
                  "@/**",
                  ":PATH:"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/frontend/**", "apps/docs/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        },
        "rules": {
          "correctness": {
            // The React Compiler memoizes; the rules ban useCallback/useMemo, which is what
            // this rule asks for whenever a component-scoped function is a dependency.
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      // Remotion renders these components to video frames: no assistive tech, no reordering.
      "includes": ["apps/demo-video/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        },
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      // `emitDecoratorMetadata` derives `design:paramtypes` from constructor parameter types, so a
      // tsyringe-injected class must stay a value import: `import type` erases it and DI fails at
      // runtime with `TypeInfo not known for "Object"`. This rule and its auto-fix can't tell, so
      // it's off for the whole backend; `verbatimModuleSyntax` still makes tsc reject value
      // imports of pure types.
      "includes": ["apps/backend/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
