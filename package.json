{
  "name": "depvault",
  "author": "Sukhrob Ilyosbekov <suxrobgm@gmail.com>",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "bun run --filter \"*\" typecheck",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "ci": "biome ci --error-on-warnings .",
    "knip": "knip",
    "cli:generate": "cd apps/backend && bun run export:openapi && cd ../.. && dotnet kiota generate -l CSharp -d apps/cli/openapi.json -o apps/cli/ApiClient -n DepVault.Cli.ApiClient --exclude-backward-compatible"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,css,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0"
  },
  "patchedDependencies": {
    "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs@4.6.1.patch"
  }
}
