/**
 * One client-encrypted blob per file in a repo. Identity is the repo-root-relative `path`;
 * apps, environments and file kinds are not modelled; the path says it all.
 * `version` increments on every write (content change, move) and doubles as the optimistic
 * concurrency token: writers send the version they based their change on and get a 409 when
 * the file moved on in between. Every version, including the current one, has a
 * RepoFileVersion row, so history is complete and each row carries its own message and author.
 */

model RepoFile {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  path             String
  version          Int      @default(1)
  encryptedContent Bytes    @map("encrypted_content")
  iv               String
  authTag          String   @map("auth_tag")
  // Keyed HMAC of the plaintext (key derived from the project DEK). Opaque to the server; lets
  // clients detect changes and renames without downloading content.
  contentHash      String   @map("content_hash")
  fileSize         Int      @map("file_size")
  isBinary         Boolean  @default(false) @map("is_binary")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  versions RepoFileVersion[]

  @@unique([projectId, path])
  @@map("repo_files")
}

model RepoFileVersion {
  id               String   @id @default(uuid()) @db.Uuid
  repoFileId       String   @map("repo_file_id") @db.Uuid
  version          Int
  path             String
  encryptedContent Bytes    @map("encrypted_content")
  iv               String
  authTag          String   @map("auth_tag")
  contentHash      String   @map("content_hash")
  fileSize         Int      @map("file_size")
  isBinary         Boolean  @default(false) @map("is_binary")
  changedBy        String   @map("changed_by") @db.Uuid
  message          String?
  createdAt        DateTime @default(now()) @map("created_at")

  repoFile RepoFile @relation(fields: [repoFileId], references: [id], onDelete: Cascade)

  @@unique([repoFileId, version])
  @@map("repo_file_versions")
}
