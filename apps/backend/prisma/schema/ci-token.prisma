/**
 * Split CI token (`dvci_<auth>.<key>`): the server stores only SHA-256(`dvci_<auth>`) and the
 * project DEK wrapped under HKDF(key part), so it can never unwrap the DEK. `paths` are glob
 * filters on file paths (empty = every file in the project).
 */
model CiToken {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  createdBy     String    @map("created_by") @db.Uuid
  name          String
  tokenHash     String    @unique @map("token_hash")
  tokenPrefix   String    @map("token_prefix")
  paths         String[]  @default([])
  ipAllowlist   String[]  @default([]) @map("ip_allowlist")
  wrappedDek    String    @map("wrapped_dek")
  wrappedDekIv  String    @map("wrapped_dek_iv")
  wrappedDekTag String    @map("wrapped_dek_tag")
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("ci_tokens")
}
