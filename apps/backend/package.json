{
  "name": "@depvault/backend",
  "version": "1.0.0",
  "private": true,
  "types": "./dist/apps/backend/src/app.d.ts",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:html": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/generate-coverage-html.ts --title \"DepVault Test Coverage Report\"",
    "dev": "bun run --watch src/app.ts",
    "start": "bun run src/app.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --create-only",
    "db:migrate:apply": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed/index.ts",
    "build:linux": "bun build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile dist/server src/app.ts",
    "build:win": "bun build --compile --minify-whitespace --minify-syntax --target bun-windows-x64 --outfile dist/server.exe src/app.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "export:openapi": "bun run scripts/export-openapi.ts",
    "stripe:seed": "bun run src/modules/subscription/stripe-seed.ts"
  },
  "dependencies": {
    "@depvault/shared": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@needle-di/core": "^1.2.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.8",
    "elysia": "^1.4.30",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
